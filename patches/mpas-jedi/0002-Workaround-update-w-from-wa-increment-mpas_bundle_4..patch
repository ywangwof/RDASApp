From f93f7a6739e529a0b309c61be4b40b5967d54c37 Mon Sep 17 00:00:00 2001
From: workaround <workaround@noaa.gov>
Date: Tue, 29 Sep 2026 19:24:30 +0000
Subject: [PATCH] Workaround: update w from wa increment (mpas_bundle_4.0.1
 method, from C. Liu)

---
 src/mpasjedi/Fields/mpas_fields_mod.F90      | 21 ++++++++++++---
 src/mpasjedi/Model/mpas_model_mod.F90        |  8 +++++-
 src/mpasjedi/State/mpas_state_mod.F90        | 27 ++++++++++++++++++++
 src/mpasjedi/Utilities/mpas2ufo_vars_mod.F90 | 14 +++++++++-
 4 files changed, 65 insertions(+), 5 deletions(-)

diff --git a/src/mpasjedi/Fields/mpas_fields_mod.F90 b/src/mpasjedi/Fields/mpas_fields_mod.F90
index b563943..7d92a06 100644
--- a/src/mpasjedi/Fields/mpas_fields_mod.F90
+++ b/src/mpasjedi/Fields/mpas_fields_mod.F90
@@ -37,7 +37,7 @@ use mpas_dmpar, only : mpas_dmpar_exch_halo_field, mpas_dmpar_exch_halo_adj_fiel
 use mpas_constants_mod
 use mpas_geom_mod
 use mpas4da_mod
-use mpas2ufo_vars_mod, only: w_to_q, theta_to_temp
+use mpas2ufo_vars_mod, only: w_to_q, theta_to_temp, unstagger_vertical_velocity
 use mpas_kinds, only : c_real_type
 
 implicit none
@@ -475,7 +475,12 @@ subroutine read_fields(self, f_conf, vdate)
       pressure%array(:,1:ngrid) = pressure_base%array(:,1:ngrid) + pressure_p%array(:,1:ngrid)
 
       !(2) copy all to subFields & diagnose temperature
-      call update_diagnostic_fields(self % geom, self % subFields, self % geom % nCellsSolve)
+      if ( self % has('upward_air_velocity') ) then
+         call update_diagnostic_fields(self % geom, self % subFields, self % geom % nCellsSolve, &
+                                       self % geom % nVertLevels)
+      else
+         call update_diagnostic_fields(self % geom, self % subFields, self % geom % nCellsSolve)
+      end if
    else
       call da_copy_all2sub_fields(self % geom, self % subFields)
    endif
@@ -483,13 +488,15 @@ subroutine read_fields(self, f_conf, vdate)
 end subroutine read_fields
 
 
-subroutine update_diagnostic_fields(geom, subFields, ngrid)
+subroutine update_diagnostic_fields(geom, subFields, ngrid, nVL)
 
    implicit none
    type (mpas_geom),      pointer,  intent(in)    :: geom
    type (mpas_pool_type), pointer,  intent(inout) :: subFields
    integer,                         intent(in)    :: ngrid
+   integer, optional,               intent(in)    :: nVL
    type (field2DReal), pointer    :: theta, pressure, temperature, specific_humidity
+   type (field2DReal), pointer    :: wc, wa
    type (field3DReal), pointer    :: scalars
    type (mpas_pool_type), pointer :: state
    integer, pointer :: index_qv
@@ -519,6 +526,14 @@ subroutine update_diagnostic_fields(geom, subFields, ngrid)
    ! Only accept background refl10cm no lower than 0 dBZ
    call da_posdef( subFields, ['equivalent_reflectivity_factor'])
 
+   ! wa(k) = 0.5 * (w(k) + w(k+1)), k = 1 ... nVL. Same diagnosis as mpas_bundle_4.0.1.
+   if (present(nVL)) then
+      call mpas_pool_get_field(geom % domain % blocklist % allFields, 'w', wc)
+      call mpas_pool_get_field(subFields, 'upward_air_velocity', wa)
+      call unstagger_vertical_velocity( wc % array(1:nVL+1, 1:ngrid), &
+                                        wa % array(1:nVL, 1:ngrid), ngrid, nVL)
+   end if
+
 end subroutine update_diagnostic_fields
 
 ! ------------------------------------------------------------------------------
diff --git a/src/mpasjedi/Model/mpas_model_mod.F90 b/src/mpasjedi/Model/mpas_model_mod.F90
index 9c06925..64f4322 100644
--- a/src/mpasjedi/Model/mpas_model_mod.F90
+++ b/src/mpasjedi/Model/mpas_model_mod.F90
@@ -366,7 +366,13 @@ subroutine model_propagate(self, jedi_state)
       call atm_compute_output_diagnostics(state, 1, diag, mesh)
 
       !(2) copy all to subFields & diagnose temperature
-      call update_diagnostic_fields(jedi_state % geom, jedi_state % subFields, jedi_state % geom % nCellsSolve)
+      if ( jedi_state % has('upward_air_velocity') ) then
+         call update_diagnostic_fields(jedi_state % geom, jedi_state % subFields, &
+                                      jedi_state % geom % nCellsSolve, jedi_state % geom % nVertLevels)
+      else
+         call update_diagnostic_fields(jedi_state % geom, jedi_state % subFields, &
+                                      jedi_state % geom % nCellsSolve)
+      end if
    !end if
 
 end subroutine model_propagate
diff --git a/src/mpasjedi/State/mpas_state_mod.F90 b/src/mpasjedi/State/mpas_state_mod.F90
index 350e3b8..55a6c5f 100644
--- a/src/mpasjedi/State/mpas_state_mod.F90
+++ b/src/mpasjedi/State/mpas_state_mod.F90
@@ -72,6 +72,7 @@ subroutine add_incr(self, increment)
    integer :: i, k, ngrid
    type (mpas_pool_type), pointer :: state, diag, mesh
    type (field2DReal), pointer :: fld2d_pb, fld2d_u, fld2d_u_inc, fld2d_uRm, fld2d_uRz
+   type (field2DReal), pointer :: fld2d_w, fld2d_w_inc, fld2d_wa_inc
    type (field1DReal), pointer :: fld1d_u10 => null(), fld1d_v10 => null()
    type (field2DReal), pointer :: fld2d_p, fld2d_dp, fld2d_drho, fld2d_dth, fld2d_dqv
    real(kind=RKIND), dimension(:,:), pointer :: ptrr2_qv, ptrr2_sh
@@ -227,6 +228,32 @@ subroutine add_incr(self, increment)
       !   fld1d_u10%array(1:ngrid) = fld1d_u10%array(1:ngrid) + fld2d_uRz%array(1,1:ngrid)
       !   fld1d_v10%array(1:ngrid) = fld1d_v10%array(1:ngrid) + fld2d_uRm%array(1,1:ngrid)
       !endif
+
+      ! Update vertical velocity from upward_air_velocity in increment space
+      ! (mpas_bundle_4.0.1). w_new = w_background + Stagger(dw):
+      !   k=1:        dw(1) = dwa(1)
+      !   k=2...nVL:  dw(k) = 0.5 * (dwa(k) + dwa(k-1))
+      !   k=nVL+1:    dw(nVL+1) = dwa(nVL)
+      if ( self%has('w') .and. &
+         increment%has('upward_air_velocity') .and. &
+         .not.increment%has('w')  )then
+         call mpas_pool_get_field(self%subFields, 'w', fld2d_w)
+         call mpas_pool_get_field(increment%subFields, 'upward_air_velocity', fld2d_wa_inc)
+         call mpas_duplicate_field(fld2d_w, fld2d_w_inc)
+
+         do k = 1, self%geom%nVertLevelsP1
+            if (k == 1) then
+               fld2d_w_inc%array(k,:) = fld2d_wa_inc%array(1,:)
+            else if (k <= self%geom%nVertLevels) then
+               fld2d_w_inc%array(k,:) = MPAS_JEDI_HALF_kr * (fld2d_wa_inc%array(k,:) + fld2d_wa_inc%array(k-1,:))
+            else
+               fld2d_w_inc%array(k,:) = fld2d_wa_inc%array(self%geom%nVertLevels,:)
+            end if
+         end do
+
+         fld2d_w%array = fld2d_w%array + fld2d_w_inc%array
+         call mpas_deallocate_field( fld2d_w_inc )
+      endif
    else
       call abor1_ftn("mpas_state:add_incr: dimension mismatch")
    endif
diff --git a/src/mpasjedi/Utilities/mpas2ufo_vars_mod.F90 b/src/mpasjedi/Utilities/mpas2ufo_vars_mod.F90
index 8c8c1cb..a67c3f9 100644
--- a/src/mpasjedi/Utilities/mpas2ufo_vars_mod.F90
+++ b/src/mpasjedi/Utilities/mpas2ufo_vars_mod.F90
@@ -48,7 +48,8 @@ private
 ! public variable conversions
 ! model2analysis
 public :: theta_to_temp, &
-          w_to_q
+          w_to_q, &
+          unstagger_vertical_velocity
 
 ! analysis2model
 public :: hydrostatic_balance
@@ -207,6 +208,17 @@ elemental subroutine w_to_q(mixing_ratio, specific_humidity)
    specific_humidity = mixing_ratio / (MPAS_JEDI_ONE_kr + mixing_ratio)
 end subroutine w_to_q
 !-------------------------------------------------------------------------------------------
+subroutine unstagger_vertical_velocity(w, wa, nC, nV)
+! Convert vertical velocity from staggered interfaces to mid-levels:
+!   wa(k) = 0.5 * (w(k) + w(k+1))  for k = 1 ... nV
+   implicit none
+   real (kind=RKIND), dimension(nV+1,nC), intent(in) :: w
+   real (kind=RKIND), dimension(nV,nC), intent(out)  :: wa
+   integer, intent(in) :: nC, nV
+
+   wa(:,1:nC) = MPAS_JEDI_HALF_kr * ( w(1:nV,1:nC) + w(2:nV+1,1:nC) )
+end subroutine unstagger_vertical_velocity
+!-------------------------------------------------------------------------------------------
 elemental subroutine q_to_w(specific_humidity, mixing_ratio)
    implicit none
    real (kind=RKIND), intent(in)  :: specific_humidity
-- 
2.47.3

